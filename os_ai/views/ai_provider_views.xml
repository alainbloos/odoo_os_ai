<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- AI Provider — Form View                                       -->
    <!-- ============================================================ -->
    <record id="view_ai_provider_form" model="ir.ui.view">
        <field name="name">ai.provider.form</field>
        <field name="model">os.ai.provider</field>
        <field name="arch" type="xml">
            <form string="AI Provider">
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. My OpenAI"/>
                        </h1>
                    </div>
                    <div invisible="not model_status_message" class="alert alert-warning" role="alert">
                        <i class="fa fa-exclamation-triangle"/> <field name="model_status_message" class="d-inline"/>
                        <button name="action_apply_model_replacement" type="object"
                                string="Use suggested model" class="btn-link" icon="fa-exchange"
                                invisible="not model_replacement"
                                confirm="Switch this provider to the suggested model? This may change results and costs."/>
                        <field name="model_replacement" invisible="1"/>
                    </div>
                    <group>
                        <group string="Connection">
                            <field name="provider_type"/>
                            <field name="model_name" placeholder="e.g. gpt-6-luna"/>
                            <field name="api_key" password="True"/>
                            <field name="base_url" placeholder="Leave empty for standard providers"/>
                        </group>
                        <group string="Settings">
                            <field name="temperature_mode"/>
                            <field name="temperature" invisible="temperature_mode != 'custom'"/>
                            <field name="reasoning_effort"/>
                            <field name="structured_output"/>
                            <field name="max_output_tokens"/>
                            <field name="timeout"/>
                            <field name="active" invisible="1"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <group string="Capabilities" col="4">
                        <div colspan="4" invisible="provider_type != 'ollama'"
                             class="alert alert-warning mb-0" role="alert">
                            <i class="fa fa-exclamation-triangle"/> Auto-detect may not report all capabilities for Ollama models.
                            If your model supports vision or other features, enable them manually.
                        </div>
                        <field name="capable_text" widget="boolean_toggle"/>
                        <field name="capable_vision" widget="boolean_toggle"/>
                        <field name="capable_image_generation" widget="boolean_toggle"/>
                        <field name="capable_image_edit" widget="boolean_toggle"/>
                        <field name="capable_decision" widget="boolean_toggle"/>
                        <div colspan="4" invisible="provider_type != 'typesafe'"
                             class="alert alert-info mb-0" role="status">
                            <i class="fa fa-info-circle"/> Decision models answer typed questions (yes/no, one option) with
                            probabilities. Only fields declared with <code>ai_compute_engine='decision'</code> use them
                            (Boolean, Selection, Many2one). Model: e.g. <code>jev-1.14.0</code>.
                        </div>
                        <div colspan="4">
                            <button name="action_detect_capabilities"
                                    type="object"
                                    string="Auto-detect"
                                    icon="fa-magic"
                                    class="btn-link"/>
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- AI Provider — Tree View                                       -->
    <!-- ============================================================ -->
    <record id="view_ai_provider_tree" model="ir.ui.view">
        <field name="name">ai.provider.tree</field>
        <field name="model">os.ai.provider</field>
        <field name="arch" type="xml">
            <tree string="AI Providers">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="provider_type"/>
                <field name="model_name"/>
                <field name="model_status_message" optional="show" decoration-warning="model_status_message"/>
                <field name="active" column_invisible="True"/>
                <field name="capable_text" optional="show"/>
                <field name="capable_vision" optional="show"/>
                <field name="capable_image_generation" optional="show"/>
                <field name="capable_image_edit" optional="show"/>
                <field name="capable_decision" optional="show"/>
            </tree>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- AI Provider — Action                                          -->
    <!-- ============================================================ -->
    <record id="action_ai_provider" model="ir.actions.act_window">
        <field name="name">AI Providers</field>
        <field name="res_model">os.ai.provider</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure your first AI Provider
            </p>
            <p>
                Connect to OpenAI, Gemini, Anthropic, DeepSeek, xAI or Mistral.
            </p>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Menu Items                                                    -->
    <!-- ============================================================ -->
    <menuitem id="menu_os_ai_root"
              name="OS AI"
              parent="base.menu_custom"
              sequence="90"/>

    <menuitem id="menu_ai_provider"
              name="AI Providers"
              parent="menu_os_ai_root"
              action="action_ai_provider"
              sequence="10"/>

</odoo>
