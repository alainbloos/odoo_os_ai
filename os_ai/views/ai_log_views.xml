<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- AI Log — Form View                                            -->
    <!-- ============================================================ -->
    <record id="view_ai_log_form" model="ir.ui.view">
        <field name="name">ai.log.form</field>
        <field name="model">os.ai.log</field>
        <field name="arch" type="xml">
            <form string="AI Log" create="0" edit="0">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="model_name" readonly="1"/>
                            <span> / </span>
                            <field name="field_name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Context">
                            <field name="model_name"/>
                            <field name="field_name"/>
                            <field name="res_ids"/>
                            <field name="batch_size"/>
                            <field name="provider_id"/>
                            <field name="provider_model"/>
                            <field name="create_date"/>
                        </group>
                        <group string="Result">
                            <field name="success"/>
                            <field name="duration"/>
                            <field name="prompt_tokens"/>
                            <field name="completion_tokens"/>
                            <field name="total_tokens"/>
                            <field name="response_cost"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="System Prompt" name="system_prompt">
                            <field name="system_prompt" readonly="1"/>
                        </page>
                        <page string="User Prompt" name="user_prompt">
                            <field name="user_prompt" readonly="1"/>
                        </page>
                        <page string="Response" name="response">
                            <field name="response_content" readonly="1"/>
                        </page>
                        <page string="Error" name="error" invisible="success">
                            <field name="error_message" readonly="1"/>
                        </page>
                        <page string="Raw Response" name="raw">
                            <field name="response_raw" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- AI Log — Tree View                                            -->
    <!-- ============================================================ -->
    <record id="view_ai_log_tree" model="ir.ui.view">
        <field name="name">ai.log.tree</field>
        <field name="model">os.ai.log</field>
        <field name="arch" type="xml">
            <list string="AI Logs" create="0" edit="0"
                  decoration-danger="not success"
                  decoration-success="success">
                <field name="create_date"/>
                <field name="model_name"/>
                <field name="field_name"/>
                <field name="batch_size"/>
                <field name="provider_id"/>
                <field name="provider_model"/>
                <field name="success"/>
                <field name="total_tokens"/>
                <field name="response_cost" sum="Total Cost"/>
                <field name="duration" sum="Total Duration"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- AI Log — Action                                               -->
    <!-- ============================================================ -->
    <record id="action_ai_log" model="ir.actions.act_window">
        <field name="name">AI Logs</field>
        <field name="res_model">os.ai.log</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No AI logs yet
            </p>
            <p>
                Every LLM call made by AI Fields is recorded here
                with full details: prompts, tokens, cost, and response.
            </p>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Menu Item                                                     -->
    <!-- ============================================================ -->
    <menuitem id="menu_ai_log"
              name="AI Logs"
              parent="menu_os_ai_root"
              action="action_ai_log"
              sequence="30"/>

</odoo>
