    <!-- DeepSeek                                                        -->
    <!-- ============================================================== -->

    <!-- The DeepSeek API documents JSON mode, not JSON Schema; reasoning off for short field values -->
    <record id="demo_provider_deepseek_flash" model="os.ai.provider">
        <field name="active" eval="False"/>
        <field name="name">DeepSeek V4.1 Flash</field>
