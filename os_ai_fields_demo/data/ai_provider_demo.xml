        <field name="model_name">gpt-6-luna</field>
        <field name="reasoning_effort">none</field>
        <field name="sequence">100</field>
        <field name="capable_text">True</field>
        <field name="capable_vision">True</field>
        <field name="capable_image_generation">False</field>
        <field name="capable_image_edit">False</field>
    </record>

