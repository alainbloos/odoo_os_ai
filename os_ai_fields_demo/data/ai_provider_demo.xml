<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Demo AI Providers representing current models and capabilities.

         They are created archived: activate the one you add an API key to.
         An active provider without key would be chosen first and fail.

         noupdate: providers already installed keep their configuration (API
         keys, model, sequence, active). Retired models are no longer created
         on new installations; existing ones show a warning with the suggested
         replacement. Providers added later use sequences >= 100, after the
         original demo providers (10 to 73). -->

    <!-- ============================================================== -->
    <!-- OpenAI                                                          -->
    <!-- ============================================================== -->

    <record id="demo_provider_gpt_5_4" model="os.ai.provider">
        <field name="active" eval="False"/>
        <field name="name">OpenAI GPT-5.4</field>
        <field name="provider_type">openai</field>
        <field name="model_name">gpt-5.4</field>
        <field name="sequence">10</field>
        <field name="capable_text">True</field>
        <field name="capable_vision">True</field>
        <field name="capable_image_generation">False</field>
        <field name="capable_image_edit">False</field>
    </record>

    <record id="demo_provider_gpt_6_luna" model="os.ai.provider">
