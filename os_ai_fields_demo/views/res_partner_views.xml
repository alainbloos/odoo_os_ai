<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_ai_demo" model="ir.ui.view">
        <field name="name">res.partner.form.ai.demo</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[last()]" position="after">
                <page string="AI Fields" name="ai_fields_demo">
                    <notebook>

                        <!-- ============================================ -->
                        <!-- TAB 1: TEXT                                   -->
                        <!-- ============================================ -->
                        <page string="Text" name="ai_text">

                            <group string="Text Fields">
                                <group>
                                    <field name="ai_greeting"/>
                                    <field name="ai_greeting_pending" widget="boolean" readonly="0"/>
                                </group>
                                <group>
                                    <field name="ai_bio"/>
                                    <field name="ai_bio_pending" widget="boolean" readonly="0"/>
                                </group>
                            </group>

                            <group string="Numeric Fields">
                                <group>
                                    <field name="ai_profile_score"/>
                                    <field name="ai_profile_score_pending" widget="boolean" readonly="0"/>
                                </group>
                                <group>
                                    <field name="ai_engagement_score" digits="[4,1]"/>
                                    <field name="ai_engagement_score_pending" widget="boolean" readonly="0"/>
                                </group>
                            </group>

                            <group string="Selection and HTML">
                                <group>
                                    <field name="ai_partner_type_suggestion"/>
                                    <field name="ai_partner_type_suggestion_pending" widget="boolean" readonly="0"/>
                                </group>
                                <group>
                                    <field name="ai_profile_card_pending" widget="boolean" readonly="0"/>
                                </group>
                                <field name="ai_profile_card" colspan="2"/>
                            </group>

                            <group string="Relational Fields">
                                <group>
                                    <field name="ai_contacts_summary"/>
                                    <field name="ai_contacts_summary_pending" widget="boolean" readonly="0"/>
                                </group>
                                <group>
                                    <field name="ai_bank_summary"/>
                                    <field name="ai_bank_summary_pending" widget="boolean" readonly="0"/>
                                </group>
                                <group>
                                    <field name="ai_suggested_country"/>
                                    <field name="ai_suggested_country_pending" widget="boolean" readonly="0"/>
                                </group>
                                <group>
                                    <field name="ai_suggested_tags" widget="many2many_tags"/>
                                    <field name="ai_suggested_tags_pending" widget="boolean" readonly="0"/>
                                </group>
                            </group>

                        </page>

                        <!-- ============================================ -->
                        <!-- TAB 2: IMAGES                                 -->
                        <!-- ============================================ -->
                        <page string="Images" name="ai_images">

                            <!-- Vision: Image → Text -->
                            <group string="Vision (Image → Text)">
                                <group>
                                    <field name="ai_photo_description"/>
                                    <field name="ai_photo_description_pending" widget="boolean" readonly="0"/>
                                </group>
                            </group>

                            <!-- Image Generation: Text → Image -->
                            <group string="Image Generation (Text → Image)">
                                <group>
                                    <field name="ai_logo" widget="image" options="{'size': [256, 256]}"/>
                                    <field name="ai_logo_pending" widget="boolean" readonly="0"/>
                                </group>
                            </group>

                            <!-- Image Editing: Image → Image -->
                            <group string="Image Editing (Image → Image)">
                                <group>
                                    <field name="ai_image_ghibli" widget="image" options="{'size': [256, 256]}"/>
                                    <field name="ai_image_ghibli_pending" widget="boolean" readonly="0"/>
                                </group>
                            </group>

                        </page>

                        <!-- ============================================ -->
                        <!-- TAB 3: DOCUMENTS                              -->
                        <!-- ============================================ -->
                        <page string="Documents" name="ai_documents">

                            <!-- PDF: HTML → PDF (wkhtmltopdf) -->
                            <group string="PDF Generation (Text → PDF)">
                                <group>
                                    <field name="ai_partner_report" filename="ai_partner_report_filename"/>
                                    <field name="ai_partner_report_filename" invisible="1"/>
                                    <field name="ai_partner_report_pending" widget="boolean" readonly="0"/>
                                </group>
                            </group>

                            <!-- Excel: JSON → XLSX (openpyxl) -->
                            <group string="Excel Generation (Text → XLSX)">
                                <group>
                                    <field name="ai_partner_spreadsheet" filename="ai_partner_spreadsheet_filename"/>
                                    <field name="ai_partner_spreadsheet_filename" invisible="1"/>
                                    <field name="ai_partner_spreadsheet_pending" widget="boolean" readonly="0"/>
                                </group>
                            </group>

                        </page>

                    </notebook>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
